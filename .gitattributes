# Normalize line endings in the repo; check out text files with LF
* text=auto eol=lf

# Scripts must keep LF so they run on Unix-like agents
*.sh   text eol=lf
*.py   text eol=lf

# Windows-only scripts keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.zip  binary
